# Copy to server/.env, then run node --env-file=server/.env server/index.js.
HOST=127.0.0.1
PORT=8787
OPENUUYC_DB_PATH=./server/data/devices.sqlite

# Direct TLS requires both files. Set HOST to the service's private IP.
# TLS_CERT_FILE=/etc/letsencrypt/live/remote.example/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/remote.example/privkey.pem
# PUBLIC_ORIGIN=https://remote.example:8787

# Allow enrollment and use from these client networks.
# DESKTOP_CLIENT_NETWORKS=192.168.50.0/24,10.8.0.0/24

# With a reverse proxy, keep HOST on loopback and set a public HTTPS origin.
# Apply the client network allowlist at the proxy and allow the proxy's IP here.
# Forward WebSocket upgrades for /socket.io/ and /v1/session.

# Optional ICE configuration for direct connections and TURN relay.
# SELF_HOST_ICE_SERVERS='[{"urls":"stun:turn.example:3478"},{"urls":"turn:turn.example:3478","username":"farwing","credential":"REPLACE_ME"}]'
