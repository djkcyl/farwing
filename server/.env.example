# Copy this file or set variables directly in the service environment.
HOST=127.0.0.1
PORT=8787
OPENUUYC_DB_PATH=./server/data/devices.sqlite

# For direct TLS, configure both files and set a public HTTPS origin.
# TLS_CERT_FILE=/etc/letsencrypt/live/remote.example/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/remote.example/privkey.pem
# PUBLIC_ORIGIN=https://remote.example

# For a trusted reverse proxy, bind this process to loopback and set the public
# HTTPS origin. The proxy must forward WebSocket upgrades for /socket.io/ and
# /v1/session as well as normal HTTP requests.
