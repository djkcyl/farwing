{
  "name": "farwing-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Farwing Server web console (user centre, administration, view-only browser viewer)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/compress.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write src",
    "check": "tsc -b && oxlint && prettier --check src && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
